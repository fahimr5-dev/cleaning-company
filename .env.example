# =============================================================================
# CleanOS — environment settings
# -----------------------------------------------------------------------------
# HOW TO USE THIS FILE
#   1. Make a copy of it called exactly ".env"  ->  cp .env.example .env
#   2. Fill in the values below by following the instructions above each one.
#   3. Restart the app after any change (Ctrl+C, then `npm run dev`).
#
# NEVER commit your .env file or paste these values into a chat, email or
# screenshot. Two of them (the service role key and the Stripe secret key) give
# complete control of your data and your money.
#
# Phase 1 only needs the four settings in SECTION 1. Everything below that is
# needed by later phases and is marked with the phase that first uses it.
# =============================================================================


# -----------------------------------------------------------------------------
# SECTION 1 — SUPABASE (needed now, Phase 1)
# Supabase is your database and your login system. It is free to start.
#
# Create a project at https://supabase.com  ->  New project
#   - Name it anything, e.g. "cleanos-production"
#   - Choose the region closest to the UAE (Frankfurt or Mumbai are the usual
#     picks; there is no UAE region at the time of writing)
#   - SAVE THE DATABASE PASSWORD YOU CHOOSE. You need it twice below and
#     Supabase will not show it to you again.
# -----------------------------------------------------------------------------

# WHERE: Supabase dashboard -> Project Settings -> Data API -> Project URL
# LOOKS LIKE: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# WHERE: Supabase dashboard -> Project Settings -> API Keys -> Publishable key
#        (older projects call this the "anon" or "public" key)
# SAFE TO EXPOSE: yes. This key ends up in the browser by design. It can only do
# what your Row Level Security rules allow, which is why those rules matter.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# WHERE: Supabase dashboard -> Project Settings -> API Keys -> Secret key
#        (older projects call this the "service_role" key)
# !! DANGER !! This key bypasses every security rule. It is used only by the
# seed script to create your demo logins, and by background jobs on the server.
# If it ever leaks, rotate it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# WHERE: Supabase dashboard -> Project Settings -> Database -> Connection string
#        -> choose "Transaction pooler" (port 6543), then tick "Display
#        connection pooler" if shown.
# Replace [YOUR-PASSWORD] with the database password you saved when creating
# the project. Keep ?pgbouncer=true on the end.
# WHY POOLED: Vercel starts and stops your app constantly; the pooler stops it
# running out of database connections.
# LOOKS LIKE:
#   postgresql://postgres.abcdefghijklm:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# WHERE: same screen, but choose "Session pooler" (port 5432) instead.
# WHY A SECOND ONE: database migrations cannot run through the pooled
# connection above. This one is used only when changing the database structure.
# LOOKS LIKE:
#   postgresql://postgres.abcdefghijklm:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DIRECT_URL=


# -----------------------------------------------------------------------------
# SECTION 2 — YOUR APP'S ADDRESS (needed now, Phase 1)
# -----------------------------------------------------------------------------

# On your own computer, leave this as it is.
# Once deployed, set it to your real address, e.g. https://app.sparkleclean.ae
# WHY: it is used to build the links inside emails and WhatsApp messages.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The password given to the four demo logins created by `npm run db:seed`.
# CHANGE THIS before you put the app anywhere the public can reach it, or
# delete the four demo accounts in Supabase -> Authentication -> Users.
SEED_DEMO_PASSWORD=CleanOS!2026


# -----------------------------------------------------------------------------
# SECTION 3 — EMAIL  (Phase 5: invoices, and Phase 6: rating requests)
# Resend sends the transactional emails. Free for 3,000 emails a month.
# Sign up at https://resend.com
# -----------------------------------------------------------------------------

# WHERE: Resend dashboard -> API Keys -> Create API Key
# LOOKS LIKE: re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# The "from" address on every email you send.
# IMPORTANT: you must first verify your domain in Resend -> Domains, which means
# adding three DNS records at whoever sells you your domain. Until you do, email
# will only send to your own address.
# LOOKS LIKE: Sparkle Cleaning <billing@sparkleclean.ae>
RESEND_FROM_EMAIL=

# Where compliance warnings (visa and Emirates ID expiry) are sent. Phase 7.
COMPLIANCE_ALERT_EMAIL=


# -----------------------------------------------------------------------------
# SECTION 4 — CARD PAYMENTS  (Phase 5)
# Stripe takes card payments. Note that Stripe supports UAE businesses, but you
# will need your trade licence to activate a live account.
# Sign up at https://stripe.com
# -----------------------------------------------------------------------------

# WHERE: Stripe dashboard -> Developers -> API keys -> Secret key
# Use the TEST key (starts sk_test_) until you are ready to take real money.
# !! DANGER !! The live key can move real money. Treat it like your bank login.
STRIPE_SECRET_KEY=

# WHERE: same screen -> Publishable key. Safe to expose; it goes in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# WHERE: Stripe dashboard -> Developers -> Webhooks -> Add endpoint
#   Endpoint URL: https://YOUR-DOMAIN/api/webhooks/stripe
#   Events to send: checkout.session.completed, payment_intent.succeeded,
#                   charge.refunded
# Then copy the "Signing secret" it shows you.
# WHY: this is how Stripe tells CleanOS that an invoice was paid. Without it,
# card payments will succeed but the invoice will still say unpaid.
STRIPE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# SECTION 5 — BACKGROUND JOBS  (Phase 5 onwards)
# These run on a timer: payment reminders, rating requests, visa expiry alerts.
# -----------------------------------------------------------------------------

# Invent a long random password of your own and put the same value in Vercel.
# WHY: it stops anyone on the internet triggering your reminder emails by
# visiting the scheduled-job URL. Generate one with:  openssl rand -base64 32
CRON_SECRET=
