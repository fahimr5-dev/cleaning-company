// ============================================================================
// CleanOS — Cleaning Company Management Platform (UAE)
// Prisma schema — PROPOSAL v1 (Phase 1)
// ----------------------------------------------------------------------------
// CONVENTIONS USED THROUGHOUT THIS FILE
//
//  * Money  : every amount is an INTEGER of FILS (1 AED = 100 fils). Never a
//             decimal/float. A field ending in "Fils" is always money.
//  * Rates  : percentages are stored in BASIS POINTS ("Bps"). 500 = 5.00%.
//             This keeps VAT and discounts exact, same reasoning as fils.
//  * IDs    : UUIDs. `User.id` is deliberately NOT auto-generated — it is the
//             exact same UUID Supabase Auth issues, so the database can ask
//             "is auth.uid() allowed to see this row?" in RLS policies.
//  * Delete : nothing is ever really deleted. `deletedAt` + `deletedById`.
//  * Who    : columns like `createdById` / `approvedById` hold a User UUID but
//             are plain columns (no foreign key) on purpose — otherwise every
//             table would need a back-link on User and the schema would become
//             unreadable. The AuditLog table is the one place we join to User.
//  * Naming : Prisma models are PascalCase (what you write in code); the actual
//             Postgres tables are snake_case plural via @@map (what you see in
//             the Supabase dashboard and in RLS policies).
//  * i18n   : any text a customer can see exists twice — `xxxEn` and `xxxAr`.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS — fixed lists of allowed values, so bad data cannot be typed in
// ============================================================================

enum Role {
  OWNER // sees and changes everything, including money settings
  OPS_MANAGER // scheduling, staff, clients, complaints — no financial settings
  CLEANER // mobile only: today's jobs, checklist, photos, clock in/out
  CLIENT // self-service portal
}

enum Locale {
  EN
  AR
}

enum ClientType {
  RESIDENTIAL
  COMMERCIAL
}

enum ClientStatus {
  ACTIVE
  PAUSED
  CHURNED
}

enum BillingMode {
  PER_JOB // invoice raised each time a job is completed
  MONTHLY_CONSOLIDATED // one invoice at month end (typical for offices)
}

enum PropertyType {
  APARTMENT
  VILLA
  OFFICE
  RETAIL
  WAREHOUSE
  OTHER
}

enum ServiceCategory {
  CORE // the main clean being bought
  ADDON // sold on top: AC duct, sofa shampoo, etc.
}

enum PricingModel {
  FLAT // one fixed price
  PER_ROOM // base + per bedroom + per bathroom
  PER_SQM // base + per square metre
  PER_HOUR // base + per hour
  PER_UNIT // per AC vent, per sofa seat, per carpet
}

enum Frequency {
  ONE_OFF
  WEEKLY
  BI_WEEKLY
  MONTHLY
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum LeadSource {
  GOOGLE
  INSTAGRAM
  FACEBOOK
  TIKTOK
  REFERRAL
  WALK_IN
  REPEAT
  PARTNER
  OTHER
}

enum LostReason {
  PRICE_TOO_HIGH
  NO_AVAILABILITY
  WENT_WITH_COMPETITOR
  NO_RESPONSE
  OUT_OF_SERVICE_AREA
  NOT_SERIOUS
  OTHER
}

enum LeadActivityType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  SITE_VISIT
  STATUS_CHANGE
  QUOTE_SENT
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum JobStatus {
  SCHEDULED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_ACCESS
}

enum SeriesStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum DocumentType {
  PASSPORT
  VISA
  EMIRATES_ID
  MEDICAL_FITNESS
  LABOUR_CARD
  CONTRACT
  TRAINING_CERT
  OTHER
}

enum StaffPosition {
  CLEANER
  TEAM_LEAD
  SUPERVISOR
  DRIVER
  OFFICE
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  EMERGENCY
  MATERNITY
  HAJJ
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PhotoKind {
  BEFORE
  AFTER
  ISSUE
}

enum TicketType {
  DAMAGE
  NO_ACCESS
  ON_SITE_COMPLAINT
  CLIENT_COMPLAINT
  LOW_RATING
